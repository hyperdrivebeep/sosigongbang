{
  "manifest_version": 3,
  "name": "소식공방 · 인스타그램 게시",
  "version": "1.0.0",
  "description": "소식공방의 카드와 캡션을 로그인된 Instagram에 옮기고, 선택한 계정에 게시합니다.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
